# Ontology OS — LLM 推理配置
# 复制此文件为 .env 并填入真实 Key

# 模型后端: anthropic | minimax | openai
LLM_BACKEND=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxx

# MiniMax M1-2.7
MINIMAX_API_KEY=m1-2.7-xxx

# OpenAI 兼容 (也支持 DeepSeek 等)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Demo Admin
DEMO_ADMIN_ENABLED=true
AUTO_SEED_DEMO_DATA=true

# Anthropic environment fallback (named connections can override per agent)
ANTHROPIC_MODEL=claude-sonnet-4
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional path for server-side model connections; default: backend/.runtime/llm-connections.json
# LLM_CONNECTIONS_PATH=/secure/path/llm-connections.json

# Optional model administration guard (shared deployments)
MODEL_CONFIG_TOKEN=
MODEL_CONFIG_ALLOWED_ORIGINS=
