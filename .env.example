# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology_demo_password
# For Docker: bolt://neo4j:7687
# For local dev: bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j

# Ports
BACKEND_PORT=8765
FRONTEND_PORT=5173

# Optional LLM configuration
# Leave blank to use deterministic fallback mode.
# Set LLM_BACKEND to one of: openai, anthropic, minimax
LLM_BACKEND=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
